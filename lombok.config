# Project-wide Lombok rules
config.stopBubbling = true
# Mark generated code so JaCoCo and Sonar ignore it
lombok.addLombokGeneratedAnnotation = true
lombok.log.fieldName = log
lombok.anyConstructor.addConstructorProperties = false
# Copy @Qualifier / @Value onto constructors generated by @RequiredArgsConstructor
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
# Banned features (hide bugs on JPA entities or reduce readability)
lombok.data.flagUsage = error
lombok.val.flagUsage = error
lombok.var.flagUsage = error
lombok.experimental.flagUsage = error
lombok.sneakyThrows.flagUsage = error
